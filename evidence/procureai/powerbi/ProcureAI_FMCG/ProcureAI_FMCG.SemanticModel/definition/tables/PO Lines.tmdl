table 'PO Lines'
	lineageTag: d0079a1c-9370-50cb-a8ab-099189adc7e4

	/// Purchase price variance in ₹ lakh.
	measure 'PPV Lakh' = DIVIDE ( [Purchase Price Variance], 100000 )
		formatString: ₹#,0.0 L
		displayFolder: Presentation
		lineageTag: ba11cd67-b6b8-5acd-8b93-398d65d16438

	/// Committed PO spend in ₹ crore.
	measure 'Committed Spend Cr' = DIVIDE ( [Committed Spend], 10000000 )
		formatString: ₹#,0.0 Cr
		displayFolder: Presentation
		lineageTag: cdb1aaa5-93a1-5ee2-8bd2-5933b2400943

	/// PO-line net for non-cancelled POs (commitment, not realized spend).
	measure 'Committed Spend' = CALCULATE ( SUM ( 'PO Lines'[line_net_amount] ), 'PO Lines'[is_committed] = TRUE () )
		formatString: ₹ #,##0
		displayFolder: Spend
		lineageTag: 51ef4c2c-7328-5148-9010-76e35ddc046f

	/// Σ (PO unit price − baseline price) × ordered qty on committed PO lines.
	measure 'Purchase Price Variance' = SUM ( 'PO Lines'[ppv_amount] )
		formatString: ₹ #,##0
		displayFolder: Price
		lineageTag: 109000dc-f360-58cd-963c-52fc9a88ba83

	/// PPV ÷ baseline value of committed PO lines.
	measure 'PPV %' = DIVIDE ( [Purchase Price Variance], SUM ( 'PO Lines'[baseline_value] ) )
		formatString: 0.00%
		displayFolder: Price
		lineageTag: 494060fe-78eb-5090-95ce-9a5012bae82f

