	partition 'PO Lines' = m
		mode: import
		source =
				// Power Query M — table 'PO Lines'. Parameters: pServer, pDatabase, pSourceMode ("PostgreSQL" | "CsvFolder"), pCsvFolder
				let
				    Source = if pSourceMode = "PostgreSQL" then
				        PostgreSQL.Database(pServer, pDatabase, [Query = "SELECT po_line_id, po_id, order_date_key, supplier_id, material_id, category_id, business_unit_id, warehouse_id, buyer_id, contract_id, is_committed, line_net_amount, ppv_amount, baseline_value, contract_valid_at_order_source, contract_flag_conflict, promise_revised_flag FROM mart.fct_purchase_order_line", CreateNavigationProperties = false])
				    else
				        Csv.Document(Binary.Decompress(File.Contents(pCsvFolder & "\po_lines.csv.gz"), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = if pSourceMode = "PostgreSQL" then Source else Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"po_line_id", type text}, {"po_id", type text}, {"order_date_key", Int64.Type}, {"supplier_id", type text}, {"material_id", type text}, {"category_id", type text}, {"business_unit_id", type text}, {"warehouse_id", type text}, {"buyer_id", type text}, {"contract_id", type text}, {"is_committed", type logical}, {"line_net_amount", type number}, {"ppv_amount", type number}, {"baseline_value", type number}, {"contract_valid_at_order_source", type logical}, {"contract_flag_conflict", type logical}, {"promise_revised_flag", type logical}}, "en-IN")
				in
				    Typed

