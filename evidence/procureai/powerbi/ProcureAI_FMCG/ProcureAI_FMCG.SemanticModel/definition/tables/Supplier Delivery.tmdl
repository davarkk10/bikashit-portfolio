table 'Supplier Delivery'
	lineageTag: 3614c49c-952f-5b05-acbc-90f4831c8fd5

	/// OTIF rate, blank for the partial last month.
	measure 'OTIF % (complete months)' = IF ( MAX ( 'Date'[month_start] ) < DATE ( 2026, 2, 1 ), [OTIF %] )
		formatString: 0.0%
		displayFolder: Presentation
		lineageTag: 7018b0b9-c423-559a-8640-a4c0a4d1aaea

	/// Service-eligible PO lines in context.
	measure 'Eligible Delivery Lines' = COUNTROWS ( 'Supplier Delivery' )
		formatString: #,##0
		displayFolder: Delivery
		lineageTag: c8096e2e-682f-54a2-9af6-85019a3ac6a7

	/// Final receipt on/before ORIGINAL promise date ÷ eligible lines.
	measure 'On-Time Rate' = DIVIDE ( SUM ( 'Supplier Delivery'[on_time] ), [Eligible Delivery Lines] )
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: 5535e4a2-8596-5c87-96ab-c7d65f6408bb

	/// Accepted qty ≥ ordered qty ÷ eligible lines.
	measure 'In-Full Rate' = DIVIDE ( SUM ( 'Supplier Delivery'[in_full] ), [Eligible Delivery Lines] )
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: 8fc6f8f4-6b29-5b7c-81ea-856626d7bb7c

	/// On-time AND in-full ÷ eligible lines.
	measure 'OTIF %' = DIVIDE ( SUM ( 'Supplier Delivery'[otif] ), [Eligible Delivery Lines] )
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: 40c88983-b288-5433-9a89-c77bcad4a262

	/// OTIF by ORDER date (inactive relationship activated).
	measure 'OTIF % by Order Date' = CALCULATE ( [OTIF %], USERELATIONSHIP ( 'Supplier Delivery'[order_date_key], 'Date'[date_key] ) )
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: fc63c7a8-0b58-533d-b13b-76ede212624b

