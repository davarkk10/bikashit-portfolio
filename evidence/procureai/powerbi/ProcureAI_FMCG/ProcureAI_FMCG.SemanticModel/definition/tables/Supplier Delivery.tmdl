	partition 'Supplier Delivery' = m
		mode: import
		source =
				// Power Query M — table 'Supplier Delivery'. Parameters: pServer, pDatabase, pSourceMode ("PostgreSQL" | "CsvFolder"), pCsvFolder
				let
				    Source = if pSourceMode = "PostgreSQL" then
				        PostgreSQL.Database(pServer, pDatabase, [Query = "SELECT po_line_id, supplier_id, warehouse_id, category_id, material_id, business_unit_id, order_date_key, promised_date_key, receipt_date_key, on_time, in_full, otif, days_late, line_net_amount FROM mart.fct_supplier_delivery", CreateNavigationProperties = false])
				    else
				        Csv.Document(Binary.Decompress(File.Contents(pCsvFolder & "\supplier_delivery.csv.gz"), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = if pSourceMode = "PostgreSQL" then Source else Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"po_line_id", type text}, {"supplier_id", type text}, {"warehouse_id", type text}, {"category_id", type text}, {"material_id", type text}, {"business_unit_id", type text}, {"order_date_key", Int64.Type}, {"promised_date_key", Int64.Type}, {"receipt_date_key", Int64.Type}, {"on_time", Int64.Type}, {"in_full", Int64.Type}, {"otif", Int64.Type}, {"days_late", Int64.Type}, {"line_net_amount", type number}}, "en-IN")
				in
				    Typed

