	partition 'Invoice Exceptions' = m
		mode: import
		source =
				// Power Query M — table 'Invoice Exceptions'. Parameters: pServer, pDatabase, pSourceMode ("PostgreSQL" | "CsvFolder"), pCsvFolder
				let
				    Source = if pSourceMode = "PostgreSQL" then
				        PostgreSQL.Database(pServer, pDatabase, [Query = "SELECT invoice_id, supplier_id, business_unit_id, warehouse_id, buyer_id, contract_id, date_key, invoice_gross_amount, has_exception, exception_status, exception_age_days, exception_value, flag_missing_po, flag_price_over_tolerance, flag_qty_over_receipt, flag_probable_duplicate, flag_bank_detail_change, approval_cycle_hours, final_approval_status, is_paid, risk_score, risk_band, flag_for_review, model_version, document_path FROM mart.pbi_invoice_exceptions", CreateNavigationProperties = false])
				    else
				        Csv.Document(Binary.Decompress(File.Contents(pCsvFolder & "\invoice_exceptions.csv.gz"), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = if pSourceMode = "PostgreSQL" then Source else Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"invoice_id", type text}, {"supplier_id", type text}, {"business_unit_id", type text}, {"warehouse_id", type text}, {"buyer_id", type text}, {"contract_id", type text}, {"date_key", Int64.Type}, {"invoice_gross_amount", type number}, {"has_exception", type logical}, {"exception_status", type text}, {"exception_age_days", type number}, {"exception_value", type number}, {"flag_missing_po", Int64.Type}, {"flag_price_over_tolerance", Int64.Type}, {"flag_qty_over_receipt", Int64.Type}, {"flag_probable_duplicate", Int64.Type}, {"flag_bank_detail_change", Int64.Type}, {"approval_cycle_hours", type number}, {"final_approval_status", type text}, {"is_paid", type logical}, {"risk_score", type number}, {"risk_band", type text}, {"flag_for_review", type logical}, {"model_version", type text}, {"document_path", type text}}, "en-IN")
				in
				    Typed

