table 'Invoice Exceptions'
	lineageTag: a5a26fd0-70dd-5fb5-b46b-6f62a5450adc

	/// Average approval cycle hours, blank for the partial last month.
	measure 'Approval Hours (complete months)' = IF ( MAX ( 'Date'[month_start] ) < DATE ( 2026, 2, 1 ), [Average Approval Cycle Hours] )
		formatString: #,0.0
		displayFolder: Presentation
		lineageTag: 53520266-e0f2-57fc-8c52-f35a044b9458

	/// Probable duplicate value in ₹ crore.
	measure 'Probable Duplicate Cr' = DIVIDE ( [Probable Duplicate Value], 10000000 )
		formatString: ₹#,0.0 Cr
		displayFolder: Presentation
		lineageTag: 00045b2c-2650-5910-9eb5-d84c90385b36

	/// Exception invoice value in ₹ crore.
	measure 'Exception Value Cr' = DIVIDE ( [Exception Invoice Value], 10000000 )
		formatString: ₹#,0.0 Cr
		displayFolder: Presentation
		lineageTag: 63d90ec1-0a1e-500b-936d-8c91524a5e2e

	/// Mean hours from Submitted to final approval event.
	measure 'Average Approval Cycle Hours' = AVERAGE ( 'Invoice Exceptions'[approval_cycle_hours] )
		formatString: #,##0.0
		displayFolder: Invoices
		lineageTag: 7482f9e8-b52d-5581-874b-45310016a6e4

	/// Invoices with ≥1 exception reason (missing PO, price, quantity, duplicate, bank change).
	measure 'Exception Invoice Count' = CALCULATE ( COUNTROWS ( 'Invoice Exceptions' ), 'Invoice Exceptions'[has_exception] = TRUE () )
		formatString: #,##0
		displayFolder: Invoices
		lineageTag: 256392ff-99af-5f19-a549-caf59ffcde88

	/// Gross value of exception invoices.
	measure 'Exception Invoice Value' = SUM ( 'Invoice Exceptions'[exception_value] )
		formatString: ₹ #,##0
		displayFolder: Invoices
		lineageTag: a53e0e33-53a7-5b48-866f-3855d7bd58e7

	/// Unresolved exceptions (final approval status = Request information).
	measure 'Open Exception Count' = CALCULATE ( COUNTROWS ( 'Invoice Exceptions' ), 'Invoice Exceptions'[exception_status] = "OPEN" )
		formatString: #,##0
		displayFolder: Invoices
		lineageTag: c8be37d7-99a1-557b-aca0-925351dc33c8

	/// Invoices whose calibrated model band is HIGH or CRITICAL (investigation priority, not fraud).
	measure 'High-Risk Invoice Count' = CALCULATE ( COUNTROWS ( 'Invoice Exceptions' ), 'Invoice Exceptions'[risk_band] IN { "HIGH", "CRITICAL" } )
		formatString: #,##0
		displayFolder: Invoices
		lineageTag: 100c9901-10f7-58ab-81a5-f4766bc8d3ff

	/// Gross of invoices matching an EARLIER invoice (same supplier; same number or amount in 30 days).
	measure 'Probable Duplicate Value' = CALCULATE ( SUM ( 'Invoice Exceptions'[invoice_gross_amount] ), 'Invoice Exceptions'[flag_probable_duplicate] = 1 )
		formatString: ₹ #,##0
		displayFolder: Invoices
		lineageTag: 8199bf14-2370-502f-a217-930f1bbc5eee

	/// Exception invoices filtered by Anomaly Type through the reason bridge WITHOUT a bidirectional relationship.
	measure 'Exception Invoices by Reason' = CALCULATE ( [Exception Invoice Count], TREATAS ( VALUES ( 'Invoice Reasons'[invoice_id] ), 'Invoice Exceptions'[invoice_id] ) )
		formatString: #,##0
		displayFolder: Invoices
		lineageTag: 1a3861a1-0901-521e-8fce-cdcc83661a6b

