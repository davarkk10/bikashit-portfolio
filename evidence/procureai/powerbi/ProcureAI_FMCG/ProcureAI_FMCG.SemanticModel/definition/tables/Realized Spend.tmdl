table 'Realized Spend'
	lineageTag: 67042162-77f4-5b93-b4f5-5503cc90c478

	/// Net spend in ₹ crore, blank for the partial last month so trend lines do not dip.
	measure 'Net Spend Cr (complete months)' = IF ( MAX ( 'Date'[month_start] ) < DATE ( 2026, 2, 1 ), DIVIDE ( [Realized Net Spend], 10000000 ) )
		formatString: ₹#,0.0 Cr
		displayFolder: Presentation
		lineageTag: a7e91bc2-36c7-588b-baeb-72791bb20e31

	/// Off-contract spend in ₹ crore.
	measure 'Off-Contract Spend Cr' = DIVIDE ( [Off-Contract Spend], 10000000 )
		formatString: ₹#,0.0 Cr
		displayFolder: Presentation
		lineageTag: d2308f46-b40f-5063-86ff-763cef2e8d0e

	/// Realized net spend in ₹ crore.
	measure 'Net Spend Cr' = DIVIDE ( [Realized Net Spend], 10000000 )
		formatString: ₹#,0.0 Cr
		displayFolder: Presentation
		lineageTag: 6362cef6-2f5e-55fc-a3a6-179fea2d7f66

	/// Sum of posted invoice-line net amount (invoice-line grain).
	measure 'Realized Net Spend' = SUM ( 'Realized Spend'[net_amount] )
		formatString: ₹ #,##0
		displayFolder: Spend
		lineageTag: f37f421c-d26c-521f-8cbe-74788695b6a1

	/// Posted invoice-line gross (net + tax); equals header gross to INR 0.01.
	measure 'Realized Gross Spend' = SUM ( 'Realized Spend'[gross_amount] )
		formatString: ₹ #,##0
		displayFolder: Spend
		lineageTag: c286e0ef-07bd-5106-a4d5-f7cad9b17f30

	/// Realized net spend with PO valid-at-order flag AND line on a contract item.
	measure 'Contracted Spend' = CALCULATE ( [Realized Net Spend], 'Realized Spend'[is_contracted] = TRUE () )
		formatString: ₹ #,##0
		displayFolder: Compliance
		lineageTag: 85666579-6fb8-507c-af20-05609d7fd090

	/// Realized net spend with no PO, no contract, contract not valid at order, or item not on contract.
	measure 'Off-Contract Spend' = CALCULATE ( [Realized Net Spend], 'Realized Spend'[is_off_contract] = TRUE () )
		formatString: ₹ #,##0
		displayFolder: Compliance
		lineageTag: 2c573d74-c0a9-5cae-b2c2-4935aaa86660

	/// Off-contract share of realized net spend; BLANK when no spend.
	measure 'Off-Contract Spend %' = DIVIDE ( [Off-Contract Spend], [Realized Net Spend] )
		formatString: 0.0%
		displayFolder: Compliance
		lineageTag: 45ec4b58-a744-5276-bba7-85bce49d0eea

	/// Distinct suppliers with realized spend in context.
	measure 'Active Suppliers' = DISTINCTCOUNT ( 'Realized Spend'[supplier_id] )
		formatString: #,##0
		displayFolder: Suppliers
		lineageTag: a9dc91e2-cdf4-5791-b495-1c0ed4f8a3e7

	/// Spend of the 10 largest suppliers in context ÷ realized net spend.
	measure 'Supplier Concentration Top 10 %' =
			VAR _top10 = TOPN ( 10, VALUES ( 'Supplier'[supplier_id] ), [Realized Net Spend], DESC )
			RETURN DIVIDE ( CALCULATE ( [Realized Net Spend], KEEPFILTERS ( _top10 ) ), [Realized Net Spend] )
		formatString: 0.0%
		displayFolder: Suppliers
		lineageTag: 26ae45e0-e416-5ca8-a92f-8de05c5fa539

