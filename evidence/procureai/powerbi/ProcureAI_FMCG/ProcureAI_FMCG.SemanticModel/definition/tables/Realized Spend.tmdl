	partition 'Realized Spend' = m
		mode: import
		source =
				// Power Query M — table 'Realized Spend'. Parameters: pServer, pDatabase, pSourceMode ("PostgreSQL" | "CsvFolder"), pCsvFolder
				let
				    Source = if pSourceMode = "PostgreSQL" then
				        PostgreSQL.Database(pServer, pDatabase, [Query = "SELECT invoice_line_id, invoice_id, date_key, supplier_id, material_id, category_id, business_unit_id, warehouse_id, buyer_id, contract_id, payment_term_id, net_amount, gross_amount, ppv_vs_baseline_amount, spend_contract_class, is_contracted, is_off_contract FROM mart.fct_realized_spend", CreateNavigationProperties = false])
				    else
				        Csv.Document(Binary.Decompress(File.Contents(pCsvFolder & "\realized_spend.csv.gz"), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = if pSourceMode = "PostgreSQL" then Source else Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"invoice_line_id", type text}, {"invoice_id", type text}, {"date_key", Int64.Type}, {"supplier_id", type text}, {"material_id", type text}, {"category_id", type text}, {"business_unit_id", type text}, {"warehouse_id", type text}, {"buyer_id", type text}, {"contract_id", type text}, {"payment_term_id", type text}, {"net_amount", type number}, {"gross_amount", type number}, {"ppv_vs_baseline_amount", type number}, {"spend_contract_class", type text}, {"is_contracted", type logical}, {"is_off_contract", type logical}}, "en-IN")
				in
				    Typed

