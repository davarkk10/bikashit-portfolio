	partition 'Security Scope' = m
		mode: import
		source =
				let
				    Source = if pSourceMode = "PostgreSQL" then
				        PostgreSQL.Database(pServer, pDatabase, [Query = "SELECT principal, rls_role, business_unit_id, category_id FROM mart.security_scope", CreateNavigationProperties = false])
				    else
				        Table.PromoteHeaders(Csv.Document(Binary.Decompress(File.Contents(pCsvFolder & "\security_scope.csv.gz"), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Source, {{"principal", type text}, {"rls_role", type text}, {"business_unit_id", type text}, {"category_id", type text}})
				in
				    Typed

