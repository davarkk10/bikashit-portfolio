	partition 'Payment Term' = m
		mode: import
		source =
				// Power Query M — table 'Payment Term'. Parameters: pServer, pDatabase, pSourceMode ("PostgreSQL" | "CsvFolder"), pCsvFolder
				let
				    Source = if pSourceMode = "PostgreSQL" then
				        PostgreSQL.Database(pServer, pDatabase, [Query = "SELECT payment_term_id, payment_term_name, net_days, discount_pct, discount_days FROM mart.dim_payment_term", CreateNavigationProperties = false])
				    else
				        Csv.Document(Binary.Decompress(File.Contents(pCsvFolder & "\payment_term.csv.gz"), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = if pSourceMode = "PostgreSQL" then Source else Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"payment_term_id", type text}, {"payment_term_name", type text}, {"net_days", Int64.Type}, {"discount_pct", type number}, {"discount_days", Int64.Type}}, "en-IN")
				in
				    Typed

