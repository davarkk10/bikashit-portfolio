	partition Buyer = m
		mode: import
		source =
				// Power Query M — table 'Buyer'. Parameters: pServer, pDatabase, pSourceMode ("PostgreSQL" | "CsvFolder"), pCsvFolder
				let
				    Source = if pSourceMode = "PostgreSQL" then
				        PostgreSQL.Database(pServer, pDatabase, [Query = "SELECT buyer_id, buyer_name, primary_category_name, business_unit_name, buyer_status FROM mart.dim_buyer", CreateNavigationProperties = false])
				    else
				        Csv.Document(Binary.Decompress(File.Contents(pCsvFolder & "\buyer.csv.gz"), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = if pSourceMode = "PostgreSQL" then Source else Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"buyer_id", type text}, {"buyer_name", type text}, {"primary_category_name", type text}, {"business_unit_name", type text}, {"buyer_status", type text}}, "en-IN")
				in
				    Typed

