	partition Date = m
		mode: import
		source =
				// Power Query M — table 'Date'. Parameters: pServer, pDatabase, pSourceMode ("PostgreSQL" | "CsvFolder"), pCsvFolder
				let
				    Source = if pSourceMode = "PostgreSQL" then
				        PostgreSQL.Database(pServer, pDatabase, [Query = "SELECT date_key, date, year, quarter_label, month, month_short, year_month, month_start, fiscal_year, fiscal_quarter, season, is_weekend, is_holiday, holiday_name FROM mart.dim_date", CreateNavigationProperties = false])
				    else
				        Csv.Document(Binary.Decompress(File.Contents(pCsvFolder & "\date.csv.gz"), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = if pSourceMode = "PostgreSQL" then Source else Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"date_key", Int64.Type}, {"date", type date}, {"year", Int64.Type}, {"quarter_label", type text}, {"month", Int64.Type}, {"month_short", type text}, {"year_month", type text}, {"month_start", type date}, {"fiscal_year", type text}, {"fiscal_quarter", Int64.Type}, {"season", type text}, {"is_weekend", type logical}, {"is_holiday", type logical}, {"holiday_name", type text}}, "en-IN")
				in
				    Typed

