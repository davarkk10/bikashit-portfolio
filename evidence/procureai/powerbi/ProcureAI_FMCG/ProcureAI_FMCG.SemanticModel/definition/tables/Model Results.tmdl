	partition 'Model Results' = m
		mode: import
		source =
				// Power Query M — table 'Model Results'. Model results, October 2026 rebuild. Parameter: pModelFolder
				let
				    Source = Csv.Document(File.Contents(pModelFolder & "\model_results.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Nulls = Promoted,
				    Typed = Table.TransformColumnTypes(Nulls, {{"area", type text}, {"method", type text}, {"role", type text}, {"method_order", Int64.Type}, {"metric", type text}, {"value", type number}}, "en-US")
				in
				    Typed

