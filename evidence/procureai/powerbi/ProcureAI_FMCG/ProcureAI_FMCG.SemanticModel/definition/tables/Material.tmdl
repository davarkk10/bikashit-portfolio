	partition Material = m
		mode: import
		source =
				// Power Query M — table 'Material'. Parameters: pServer, pDatabase, pSourceMode ("PostgreSQL" | "CsvFolder"), pCsvFolder
				let
				    Source = if pSourceMode = "PostgreSQL" then
