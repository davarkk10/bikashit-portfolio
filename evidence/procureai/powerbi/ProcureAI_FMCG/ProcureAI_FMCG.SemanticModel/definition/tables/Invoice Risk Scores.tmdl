table 'Invoice Risk Scores'
	lineageTag: ab5333a6-1930-56d1-bac7-b0b52f2f8c94

	/// Gradient-boosted model PR-AUC on the three hard conditions (test window, Python evaluation).
	measure 'Invoice Model PR-AUC (hard cases)' = CALCULATE ( MAX ( 'Model Results'[value] ), 'Model Results'[area] = "Invoice risk", 'Model Results'[metric] = "pr_auc_hard", 'Model Results'[role] = "Model" )
		formatString: 0.00
		displayFolder: Model results
		lineageTag: f7834826-3ace-5628-88a7-03a8f95eda33

	/// Best hand-written rules PR-AUC on the hard conditions.
	measure 'Invoice Rules PR-AUC (hard cases)' = CALCULATE ( MAX ( 'Model Results'[value] ), 'Model Results'[area] = "Invoice risk", 'Model Results'[metric] = "pr_auc_hard", 'Model Results'[method] = "Best hand-written rules" )
		formatString: 0.00
		displayFolder: Model results
		lineageTag: 6a221148-1f1f-57e6-b817-3a6c33df3a4a

	/// Invoices in the test window that carry an injected condition.
	measure 'Invoice Test Conditions' = CALCULATE ( COUNTROWS ( 'Invoice Risk Scores' ), 'Invoice Risk Scores'[split] = "Test", 'Invoice Risk Scores'[is_condition] = 1 )
		formatString: #,##0
		displayFolder: Model results
		lineageTag: b85c93ed-7e91-5d1f-85ff-2bb7ad6201c4

	/// Test invoices the model sends for review (review capacity).
	measure 'Model Flagged Invoices' = CALCULATE ( COUNTROWS ( 'Invoice Risk Scores' ), 'Invoice Risk Scores'[model_flag] = 1 )
		formatString: #,##0
		displayFolder: Model results
		lineageTag: 677db58e-eaba-5ecb-98b1-2fc42398cb55

	/// Flagged invoices that carry a real condition.
	measure 'Model Hits' = CALCULATE ( COUNTROWS ( 'Invoice Risk Scores' ), 'Invoice Risk Scores'[model_flag] = 1, 'Invoice Risk Scores'[is_condition] = 1 )
		formatString: #,##0
		displayFolder: Model results
		lineageTag: 51ddd7c7-ff69-543c-88c0-5bab6811470b

	/// Share of model flags that are real.
	measure 'Model Precision' = DIVIDE ( [Model Hits], [Model Flagged Invoices] )
		formatString: 0.0%
		displayFolder: Model results
		lineageTag: 6fa9d65a-fa5f-5b39-ad9a-f71d544636e0

	/// Share of real conditions the model flags.
	measure 'Model Recall' = DIVIDE ( [Model Hits], [Invoice Test Conditions] )
		formatString: 0.0%
		displayFolder: Model results
		lineageTag: c4fc8c5e-725e-5746-a47b-bc244c6b8dcb

	/// Test invoices the best hand-written rules flag.
	measure 'Rules Flagged Invoices' = CALCULATE ( COUNTROWS ( 'Invoice Risk Scores' ), 'Invoice Risk Scores'[split] = "Test", 'Invoice Risk Scores'[rules_refined] = 1 )
		formatString: #,##0
		displayFolder: Model results
		lineageTag: 0441dd45-cb14-5d57-8e28-60fb178b8fdf

	/// Rule flags that carry a real condition.
	measure 'Rules Hits' = CALCULATE ( COUNTROWS ( 'Invoice Risk Scores' ), 'Invoice Risk Scores'[split] = "Test", 'Invoice Risk Scores'[rules_refined] = 1, 'Invoice Risk Scores'[is_condition] = 1 )
		formatString: #,##0
		displayFolder: Model results
		lineageTag: c9827e75-cebd-5aab-b25e-62f1fd41cc33

	/// Share of rule flags that are real.
	measure 'Rules Precision' = DIVIDE ( [Rules Hits], [Rules Flagged Invoices] )
		formatString: 0.0%
		displayFolder: Model results
		lineageTag: 8f17e5d4-8fdb-5880-90e2-26c45090a0a0

	/// Share of real conditions the rules flag.
	measure 'Rules Recall' = DIVIDE ( [Rules Hits], [Invoice Test Conditions] )
		formatString: 0.0%
		displayFolder: Model results
		lineageTag: 28aa317f-f674-57e3-adc5-a5ce3193127e

	/// Share of each condition the best rules catch.
	measure 'Rules Caught %' = AVERAGE ( 'Invoice Condition Catch'[rules_caught] )
		formatString: 0.0%
		displayFolder: Model results
		lineageTag: 5ec284b1-24b0-531f-967d-2fbc1f757d4f

	/// Share of each condition the model catches at review capacity.
	measure 'Model Caught %' = AVERAGE ( 'Invoice Condition Catch'[model_caught] )
		formatString: 0.0%
		displayFolder: Model results
		lineageTag: 2c716cfe-c16c-5365-a2c4-1829ccb03338

