	partition 'Invoice Risk Scores' = m
		mode: import
		source =
				// Power Query M — table 'Invoice Risk Scores'. Model results, October 2026 rebuild. Parameter: pModelFolder
				let
				    Source = Csv.Document(File.Contents(pModelFolder & "\invoice_risk_scores.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Nulls = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"po_id", "model_score", "max_price_var"}),
				    Typed = Table.TransformColumnTypes(Nulls, {{"invoice_id", type text}, {"invoice_date", type date}, {"date_key", Int64.Type}, {"supplier_id", type text}, {"po_id", type text}, {"gross_amount", type number}, {"rules_policy", Int64.Type}, {"rules_refined", Int64.Type}, {"max_price_var", type number}, {"supplier_price_drift_120d", type number}, {"prior_inv_same_po", Int64.Type}, {"similar_number_seen", Int64.Type}, {"split", type text}, {"model_score", type number}, {"model_flag", Int64.Type}, {"condition", type text}, {"condition_group", type text}, {"is_condition", Int64.Type}}, "en-US")
				in
				    Typed

