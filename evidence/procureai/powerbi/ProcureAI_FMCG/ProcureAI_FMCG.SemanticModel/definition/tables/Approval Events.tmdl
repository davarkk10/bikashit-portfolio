	partition 'Approval Events' = m
		mode: import
		source =
				// Power Query M — table 'Approval Events'. Parameters: pServer, pDatabase, pSourceMode ("PostgreSQL" | "CsvFolder"), pCsvFolder
				let
				    Source = if pSourceMode = "PostgreSQL" then
