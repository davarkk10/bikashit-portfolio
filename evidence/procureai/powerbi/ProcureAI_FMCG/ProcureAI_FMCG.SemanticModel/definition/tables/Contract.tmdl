	partition Contract = m
		mode: import
		source =
				// Power Query M — table 'Contract'. Parameters: pServer, pDatabase, pSourceMode ("PostgreSQL" | "CsvFolder"), pCsvFolder
				let
				    Source = if pSourceMode = "PostgreSQL" then
				        PostgreSQL.Database(pServer, pDatabase, [Query = "SELECT contract_id, supplier_id, contract_title, contract_type, start_date, end_date, contract_status_current, contract_value, payment_term_name, price_escalation_cap_pct, termination_notice_days, auto_renewal_flag, governing_law_state, document_path, amendment_count, expiry_bucket, notice_deadline_date FROM mart.dim_contract", CreateNavigationProperties = false])
