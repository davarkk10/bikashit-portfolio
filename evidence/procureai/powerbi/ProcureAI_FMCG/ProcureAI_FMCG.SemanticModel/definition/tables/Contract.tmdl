				        Csv.Document(Binary.Decompress(File.Contents(pCsvFolder & "\contract.csv.gz"), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = if pSourceMode = "PostgreSQL" then Source else Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"contract_id", type text}, {"supplier_id", type text}, {"contract_title", type text}, {"contract_type", type text}, {"start_date", type date}, {"end_date", type date}, {"contract_status_current", type text}, {"contract_value", type number}, {"payment_term_name", type text}, {"price_escalation_cap_pct", type number}, {"termination_notice_days", type number}, {"auto_renewal_flag", type logical}, {"governing_law_state", type text}, {"document_path", type text}, {"amendment_count", Int64.Type}, {"expiry_bucket", type text}, {"notice_deadline_date", type date}}, "en-IN")
				in
				    Typed

