	partition 'Supplier Risk' = m
		mode: import
		source =
				// Power Query M — table 'Supplier Risk'. Parameters: pServer, pDatabase, pSourceMode ("PostgreSQL" | "CsvFolder"), pCsvFolder
				let
				    Source = if pSourceMode = "PostgreSQL" then
				        PostgreSQL.Database(pServer, pDatabase, [Query = "SELECT supplier_id, composite_score, risk_band AS supplier_risk_band, confidence, small_sample_flag, c_delivery, c_quality, c_commercial, c_incident, c_concentration, c_contract FROM mart.v_supplier_risk_latest", CreateNavigationProperties = false])
				    else
				        Csv.Document(Binary.Decompress(File.Contents(pCsvFolder & "\supplier_risk.csv.gz"), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = if pSourceMode = "PostgreSQL" then Source else Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"supplier_id", type text}, {"composite_score", type number}, {"supplier_risk_band", type text}, {"confidence", type number}, {"small_sample_flag", type logical}, {"c_delivery", type number}, {"c_quality", type number}, {"c_commercial", type number}, {"c_incident", type number}, {"c_concentration", type number}, {"c_contract", type number}}, "en-IN")
				in
				    Typed

