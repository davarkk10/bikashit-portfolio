table 'PO Delay Scores'
	lineageTag: 53b05d1d-db1d-51c8-b740-b96c1378c5dc

	/// Each supplier's past late rate used as the score.
	measure 'Delay Baseline PR-AUC' = CALCULATE ( MAX ( 'Model Results'[value] ), 'Model Results'[area] = "Late delivery", 'Model Results'[metric] = "pr_auc", 'Model Results'[role] = "Baseline" )
		formatString: 0.00
		displayFolder: Model results
		lineageTag: 4c503c1c-05c8-584b-b654-9ce22ffa7bfe

	/// Logistic regression scored when the PO is raised.
	measure 'Delay PR-AUC (order time)' = CALCULATE ( MAX ( 'Model Results'[value] ), 'Model Results'[area] = "Late delivery", 'Model Results'[metric] = "pr_auc", 'Model Results'[method] = "Logistic regression, order time" )
		formatString: 0.00
		displayFolder: Model results
		lineageTag: 21e4fce1-6617-579e-957b-e9712e8166af

	/// Logistic regression re-scored 3 days before the promised date.
	measure 'Delay PR-AUC (3 days out)' = CALCULATE ( MAX ( 'Model Results'[value] ), 'Model Results'[area] = "Late delivery", 'Model Results'[metric] = "pr_auc", 'Model Results'[method] = "Logistic regression, 3 days before" )
		formatString: 0.00
		displayFolder: Model results
		lineageTag: 1c115716-2bb1-51c3-8a8b-f717195934a3

	/// Share of POs received after the promised date.
	measure 'PO Late %' = DIVIDE ( SUM ( 'PO Delay Scores'[late] ), COUNTROWS ( 'PO Delay Scores' ) )
		formatString: 0.0%
		displayFolder: Model results
		lineageTag: cf851782-c2ed-5b6c-89d9-95c2e0efaa99

	/// Late rate in the test window (Jul–Dec 2025).
	measure 'Test PO Late %' = CALCULATE ( [PO Late %], 'PO Delay Scores'[split] = "Test" )
		formatString: 0.0%
		displayFolder: Model results
		lineageTag: b5eb6b8f-5710-5290-bb68-a2be6d319ded

	/// Average order-time predicted probability of a late delivery.
	measure 'Avg Predicted Late Risk' = AVERAGE ( 'PO Delay Scores'[p_order] )
		formatString: 0.0%
		displayFolder: Model results
		lineageTag: 1f287c0f-080b-54ce-9222-40863817d1b2

	/// Of the top 25% flagged 3 days out, the share that arrive late.
	measure 'Flagged PO Late % (3 days out)' = CALCULATE ( [PO Late %], 'PO Delay Scores'[flag_pre] = 1 )
		formatString: 0.0%
		displayFolder: Model results
		lineageTag: 606a4cd6-ff21-5602-b52a-612b0fa984d5

	/// Share of late test POs inside the flagged top 25%.
	measure 'Late POs Caught (3 days out)' = DIVIDE ( CALCULATE ( SUM ( 'PO Delay Scores'[late] ), 'PO Delay Scores'[flag_pre] = 1 ), CALCULATE ( SUM ( 'PO Delay Scores'[late] ), 'PO Delay Scores'[split] = "Test" ) )
		formatString: 0.0%
		displayFolder: Model results
		lineageTag: 5081ec3f-20b2-5835-a0bc-62893389d385

	/// Validation PR-AUC lost when the driver is removed.
	measure 'Delay Driver Importance' = SUM ( 'Delay Drivers'[pr_auc_lost_when_removed] )
		formatString: 0.000
		displayFolder: Model results
		lineageTag: 0fe28125-78e8-5e91-8c0f-42344d0dd454

