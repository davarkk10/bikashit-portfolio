	partition 'Anomaly Type' = m
		mode: import
		source =
				// Power Query M — table 'Anomaly Type'. Parameters: pServer, pDatabase, pSourceMode ("PostgreSQL" | "CsvFolder"), pCsvFolder
				let
				    Source = if pSourceMode = "PostgreSQL" then
				        PostgreSQL.Database(pServer, pDatabase, [Query = "SELECT reason_code, reason_label, reason_group, is_exception, routing, description FROM mart.dim_anomaly_type", CreateNavigationProperties = false])
				    else
				        Csv.Document(Binary.Decompress(File.Contents(pCsvFolder & "\anomaly_type.csv.gz"), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = if pSourceMode = "PostgreSQL" then Source else Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"reason_code", type text}, {"reason_label", type text}, {"reason_group", type text}, {"is_exception", type logical}, {"routing", type text}, {"description", type text}}, "en-IN")
				in
				    Typed

