		variation Variation
			isDefault
			relationship: 7c1b0662-7c69-4433-ac20-9a7c2534dba7
			defaultHierarchy: LocalDateTable_fb5baac3-8e4d-4174-8042-86b7eef5bd27.'Date Hierarchy'

