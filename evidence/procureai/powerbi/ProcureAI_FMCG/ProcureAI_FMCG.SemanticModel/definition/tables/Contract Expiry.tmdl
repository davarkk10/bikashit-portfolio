table 'Contract Expiry'
	lineageTag: b1e3785e-9600-53eb-9c92-2cc1bb3d1ad1

	/// Spend at risk from expiry in ₹ crore.
	measure 'Spend at Risk Cr' = DIVIDE ( [Spend at Risk from Expiry], 10000000 )
		formatString: ₹#,0.0 Cr
		displayFolder: Presentation
		lineageTag: a9eb6fb2-19d2-5050-b5ba-be44596cac68

	/// Contracts ending within 0–30 days after the reporting date.
	measure 'Contracts Expiring 30 Days' = CALCULATE ( COUNTROWS ( 'Contract Expiry' ), 'Contract Expiry'[expiry_bucket] = "0-30" )
		formatString: #,##0
		displayFolder: Contracts
		lineageTag: b5b682c9-e8b2-5894-a1b3-1d30ae39d132

	/// Contracts ending within 60 days (cumulative).
	measure 'Contracts Expiring 60 Days' = CALCULATE ( COUNTROWS ( 'Contract Expiry' ), 'Contract Expiry'[expiry_bucket] IN { "0-30", "31-60" } )
		formatString: #,##0
		displayFolder: Contracts
		lineageTag: 3517772a-8087-5ad0-bd8e-a7884a301a08

	/// Contracts ending within 90 days (cumulative).
	measure 'Contracts Expiring 90 Days' = CALCULATE ( COUNTROWS ( 'Contract Expiry' ), 'Contract Expiry'[expiry_bucket] IN { "0-30", "31-60", "61-90" } )
		formatString: #,##0
		displayFolder: Contracts
		lineageTag: eedf2af3-a3b6-56dd-b831-f6876b1881c6

	/// Trailing-12-month realized spend on contracts expiring within 90 days.
	measure 'Spend at Risk from Expiry' = SUM ( 'Contract Expiry'[spend_at_risk_90d] )
		formatString: ₹ #,##0
		displayFolder: Contracts
		lineageTag: 5399a5db-2135-5024-ac15-0f355cfa3161

	column contract_id
		dataType: string
		isHidden
		lineageTag: 6079a2c1-9c8f-5aae-9b5a-579bcec4819b
		summarizeBy: none
		sourceColumn: contract_id

