	partition 'Contract Expiry' = m
		mode: import
		source =
				// Power Query M — table 'Contract Expiry'. Parameters: pServer, pDatabase, pSourceMode ("PostgreSQL" | "CsvFolder"), pCsvFolder
				let
				    Source = if pSourceMode = "PostgreSQL" then
				        PostgreSQL.Database(pServer, pDatabase, [Query = "SELECT contract_id, supplier_id, days_to_expiry, expiry_bucket, auto_renewal_flag, notice_deadline_date, notice_window_passed, trailing_12m_spend, spend_at_risk_90d, review_obligation, document_path FROM mart.agg_contract_expiry", CreateNavigationProperties = false])
				    else
				        Csv.Document(Binary.Decompress(File.Contents(pCsvFolder & "\contract_expiry.csv.gz"), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = if pSourceMode = "PostgreSQL" then Source else Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"contract_id", type text}, {"supplier_id", type text}, {"days_to_expiry", Int64.Type}, {"expiry_bucket", type text}, {"auto_renewal_flag", type logical}, {"notice_deadline_date", type date}, {"notice_window_passed", type logical}, {"trailing_12m_spend", type number}, {"spend_at_risk_90d", type number}, {"review_obligation", type text}, {"document_path", type text}}, "en-IN")
				in
				    Typed

