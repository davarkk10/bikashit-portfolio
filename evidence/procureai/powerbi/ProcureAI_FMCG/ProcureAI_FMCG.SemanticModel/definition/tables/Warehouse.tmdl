	partition Warehouse = m
		mode: import
		source =
				// Power Query M — table 'Warehouse'. Parameters: pServer, pDatabase, pSourceMode ("PostgreSQL" | "CsvFolder"), pCsvFolder
				let
				    Source = if pSourceMode = "PostgreSQL" then
				        PostgreSQL.Database(pServer, pDatabase, [Query = "SELECT warehouse_id, warehouse_name, city, latitude, longitude, capacity_pallets FROM mart.dim_warehouse", CreateNavigationProperties = false])
				    else
				        Csv.Document(Binary.Decompress(File.Contents(pCsvFolder & "\warehouse.csv.gz"), Compression.GZip), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = if pSourceMode = "PostgreSQL" then Source else Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"warehouse_id", type text}, {"warehouse_name", type text}, {"city", type text}, {"latitude", type number}, {"longitude", type number}, {"capacity_pallets", type number}}, "en-IN")
				in
				    Typed

