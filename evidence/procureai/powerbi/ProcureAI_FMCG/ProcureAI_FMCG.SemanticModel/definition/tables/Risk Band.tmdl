	partition 'Risk Band' = m
		mode: import
		source =
				// Power Query M — table 'Risk Band'. Parameters: pServer, pDatabase, pSourceMode ("PostgreSQL" | "CsvFolder"), pCsvFolder
				let
				    Source = if pSourceMode = "PostgreSQL" then
				        PostgreSQL.Database(pServer, pDatabase, [Query = "SELECT risk_band, band_order, review_sla_days, description FROM mart.dim_risk_band", CreateNavigationProperties = false])
