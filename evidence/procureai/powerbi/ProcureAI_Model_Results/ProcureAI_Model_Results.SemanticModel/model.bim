          {
            "type": "calculated",
            "name": "Load Band",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "SWITCH ( TRUE (), fact_po[utilisation] < 0.8, \"Under 80%\", fact_po[utilisation] < 1.0, \"80–100%\", fact_po[utilisation] < 1.2, \"100–120%\", \"Over 120%\" )",
