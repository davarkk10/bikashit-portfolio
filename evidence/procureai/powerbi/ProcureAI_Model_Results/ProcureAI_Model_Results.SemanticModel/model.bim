            "name": "Delivery",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "IF ( fact_po[late] = 1, \"Late\", \"On time\" )",
            "lineageTag": "2e35a78d-2e7a-50ea-bbdf-b2a5aaeeeb6b",
