            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "_Measures-partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table(type table [Column1 = text], {})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "POs",
            "expression": "COUNTROWS ( fact_po )",
            "lineageTag": "491492fc-fe71-573f-88ec-75e4e92653c7",
            "displayFolder": "1 Overview",
            "formatString": "#,0"
          },
          {
            "name": "Invoices",
            "expression": "COUNTROWS ( fact_invoice )",
            "lineageTag": "973386af-b210-5570-8503-c17bc673cced",
            "displayFolder": "1 Overview",
            "formatString": "#,0"
          },
          {
            "name": "Invoice Value",
            "expression": "SUM ( fact_invoice[gross_amount] )",
            "lineageTag": "ab556777-047f-59ac-838e-05b36867488b",
            "displayFolder": "1 Overview",
            "formatString": "\"₹\"#,0.0,,\"M\""
          },
          {
            "name": "Suppliers",
            "expression": "COUNTROWS ( dim_supplier )",
            "lineageTag": "eab55a02-6494-5c13-af95-b2ca3ba370aa",
            "displayFolder": "1 Overview",
            "formatString": "#,0"
          },
          {
            "name": "PR-AUC Explainer",
            "expression": "\"PR-AUC: a 0-to-1 score for how well a model puts real problems at the top of the review list. Guessing scores the problem rate (about 0.04 for hard invoice cases, 0.37 for late deliveries); 1.0 is perfect.\"",
            "lineageTag": "5ac2062d-d770-56be-8036-e2b340ef892a",
            "displayFolder": "1 Overview"
          },
          {
            "name": "Invoice Model PR-AUC Hard",
            "expression": "CALCULATE ( MAX ( model_results[value] ), model_results[area] = \"Invoice risk\", model_results[metric] = \"pr_auc_hard\", model_results[role] = \"Model\" )",
            "lineageTag": "66679697-e86d-5983-8246-ceb23c156a7c",
            "displayFolder": "2 Invoice risk",
            "formatString": "0.00"
          },
          {
            "name": "Invoice Rules PR-AUC Hard",
            "expression": "CALCULATE ( MAX ( model_results[value] ), model_results[area] = \"Invoice risk\", model_results[metric] = \"pr_auc_hard\", model_results[method] = \"Best hand-written rules\" )",
            "lineageTag": "520f3109-988d-5f14-9fe4-685ea654e85c",
            "displayFolder": "2 Invoice risk",
            "formatString": "0.00"
          },
          {
            "name": "Invoice Model PR-AUC",
            "expression": "CALCULATE ( MAX ( model_results[value] ), model_results[area] = \"Invoice risk\", model_results[metric] = \"pr_auc\", model_results[role] = \"Model\" )",
            "lineageTag": "9a87ec9d-9154-529a-bfae-ad8c6bdb5fda",
            "displayFolder": "2 Invoice risk",
            "formatString": "0.00"
          },
          {
            "name": "Invoice Rules PR-AUC",
            "expression": "CALCULATE ( MAX ( model_results[value] ), model_results[area] = \"Invoice risk\", model_results[metric] = \"pr_auc\", model_results[method] = \"Best hand-written rules\" )",
            "lineageTag": "e9fc9c84-06a2-501c-8c52-08f15f0de8ed",
            "displayFolder": "2 Invoice risk",
            "formatString": "0.00"
          },
          {
            "name": "Invoice Model Callout",
            "expression": "\"Best rules \" & FORMAT ( [Invoice Rules PR-AUC Hard], \"0.00\" ) & \" · guessing ≈ 0.04\"",
            "lineageTag": "a037bb52-3aea-5ac4-85d1-b59964b25382",
            "displayFolder": "2 Invoice risk"
          },
          {
            "name": "Test Conditions",
            "expression": "CALCULATE ( [Invoices], fact_invoice[split] = \"Test\", fact_invoice[is_condition] = 1 )",
            "lineageTag": "d263a2a6-8190-5d19-92f6-1e9bbf773544",
            "displayFolder": "2 Invoice risk",
            "formatString": "#,0"
          },
          {
            "name": "Model Flagged",
            "expression": "CALCULATE ( [Invoices], fact_invoice[model_flag] = 1 )",
            "lineageTag": "b1b19827-5ba0-547f-b6cf-8a71a769cb44",
            "displayFolder": "2 Invoice risk",
            "formatString": "#,0"
          },
          {
            "name": "Model Hits",
            "expression": "CALCULATE ( [Invoices], fact_invoice[model_flag] = 1, fact_invoice[is_condition] = 1 )",
            "lineageTag": "5db780fa-3f3d-5d5e-8a30-a633f4605f31",
            "displayFolder": "2 Invoice risk",
            "formatString": "#,0"
          },
          {
            "name": "Model Precision",
            "expression": "DIVIDE ( [Model Hits], [Model Flagged] )",
            "lineageTag": "4d22f186-10ad-5626-884b-834801853da9",
            "displayFolder": "2 Invoice risk",
            "formatString": "0.0%"
          },
          {
            "name": "Model Recall",
            "expression": "DIVIDE ( [Model Hits], [Test Conditions] )",
            "lineageTag": "273e84e8-f9ef-5485-8884-fcdd12399997",
            "displayFolder": "2 Invoice risk",
            "formatString": "0.0%"
          },
          {
            "name": "Rules Flagged",
            "expression": "CALCULATE ( [Invoices], fact_invoice[split] = \"Test\", fact_invoice[rules_refined] = 1 )",
            "lineageTag": "7a43a5aa-7df6-5a07-8a8a-62a058ae8ee7",
            "displayFolder": "2 Invoice risk",
            "formatString": "#,0"
          },
          {
            "name": "Rules Hits",
            "expression": "CALCULATE ( [Invoices], fact_invoice[split] = \"Test\", fact_invoice[rules_refined] = 1, fact_invoice[is_condition] = 1 )",
            "lineageTag": "c389ceff-8ba9-5e36-898f-c08834c65af7",
            "displayFolder": "2 Invoice risk",
            "formatString": "#,0"
          },
          {
            "name": "Rules Precision",
            "expression": "DIVIDE ( [Rules Hits], [Rules Flagged] )",
            "lineageTag": "0814be8d-7dec-50d3-a15e-90e3779d1715",
            "displayFolder": "2 Invoice risk",
            "formatString": "0.0%"
          },
          {
            "name": "Rules Recall",
            "expression": "DIVIDE ( [Rules Hits], [Test Conditions] )",
            "lineageTag": "8af79450-6e89-5c3b-8b11-4a2140ac52e9",
            "displayFolder": "2 Invoice risk",
            "formatString": "0.0%"
          },
          {
            "name": "Model Precision Callout",
            "expression": "\"of \" & FORMAT ( [Model Flagged], \"#,0\" ) & \" flagged are real · catches \" & FORMAT ( [Model Recall], \"0%\" )",
            "lineageTag": "c732c005-ffac-52ab-bd1b-621e85c62a9e",
            "displayFolder": "2 Invoice risk"
          },
          {
            "name": "Rules Precision Callout",
            "expression": "\"of \" & FORMAT ( [Rules Flagged], \"#,0\" ) & \" flagged are real · catches \" & FORMAT ( [Rules Recall], \"0%\" )",
            "lineageTag": "ecd1c5aa-040d-595e-a154-f234013c28c7",
            "displayFolder": "2 Invoice risk"
          },
          {
            "name": "Rules Caught %",
            "expression": "AVERAGE ( invoice_catch[rules_caught] )",
            "lineageTag": "b2565b09-e9fb-5d9e-8c5b-e9fc4a9541d2",
            "displayFolder": "2 Invoice risk",
            "formatString": "0.0%"
          },
          {
            "name": "Model Caught %",
            "expression": "AVERAGE ( invoice_catch[model_caught] )",
            "lineageTag": "03b1c1de-fceb-53a6-aff6-356ed4a71a9a",
            "displayFolder": "2 Invoice risk",
            "formatString": "0.0%"
          },
          {
            "name": "Delay Baseline PR-AUC",
            "expression": "CALCULATE ( MAX ( model_results[value] ), model_results[area] = \"Late delivery\", model_results[metric] = \"pr_auc\", model_results[role] = \"Baseline\" )",
            "lineageTag": "bfbff6b6-86e4-58ef-940c-aad02b346fe0",
            "displayFolder": "3 Late delivery",
            "formatString": "0.00"
          },
          {
            "name": "Delay Order PR-AUC",
            "expression": "CALCULATE ( MAX ( model_results[value] ), model_results[area] = \"Late delivery\", model_results[metric] = \"pr_auc\", model_results[method] = \"Logistic regression, order time\" )",
            "lineageTag": "1826e3bd-c823-50f5-944d-7f33fffe7fb0",
            "displayFolder": "3 Late delivery",
            "formatString": "0.00"
          },
          {
            "name": "Delay Pre PR-AUC",
            "expression": "CALCULATE ( MAX ( model_results[value] ), model_results[area] = \"Late delivery\", model_results[metric] = \"pr_auc\", model_results[method] = \"Logistic regression, 3 days before\" )",
            "lineageTag": "98b08ea8-7359-5e5e-8af4-6c733498def4",
            "displayFolder": "3 Late delivery",
            "formatString": "0.00"
          },
          {
            "name": "Delay Ceiling PR-AUC",
            "expression": "CALCULATE ( MAX ( model_results[value] ), model_results[area] = \"Late delivery\", model_results[metric] = \"pr_auc\", model_results[role] = \"Ceiling\" )",
            "lineageTag": "4af0a184-2c19-5b76-81a6-93db6a5a9119",
            "displayFolder": "3 Late delivery",
            "formatString": "0.00"
          },
          {
            "name": "Delay Order Callout",
            "expression": "\"Supplier history alone \" & FORMAT ( [Delay Baseline PR-AUC], \"0.00\" ) & \" · guessing 0.37\"",
            "lineageTag": "c1acee73-49d2-5f73-9b5e-30eb996dee9d",
            "displayFolder": "3 Late delivery"
          },
          {
            "name": "Delay Pre Callout",
            "expression": "\"Adds dispatch notice and flood or bandh warnings\"",
            "lineageTag": "980bf874-920f-5183-9294-ec32cddac388",
            "displayFolder": "3 Late delivery"
          },
          {
            "name": "Late %",
            "expression": "DIVIDE ( SUM ( fact_po[late] ), [POs] )",
            "lineageTag": "42cb576a-8ad6-5e38-960a-e509a7f6e9af",
            "displayFolder": "3 Late delivery",
            "formatString": "0.0%"
          },
          {
            "name": "Test Late %",
            "expression": "CALCULATE ( [Late %], fact_po[split] = \"Test\" )",
            "lineageTag": "bec59d86-2db0-59b7-9a54-efc83e46a19d",
            "displayFolder": "3 Late delivery",
            "formatString": "0.0%"
          },
          {
            "name": "Avg Predicted Risk",
            "expression": "AVERAGE ( fact_po[p_order] )",
            "lineageTag": "e9049836-cb84-58b2-acda-7296b8de79a6",
            "displayFolder": "3 Late delivery",
            "formatString": "0.0%"
          },
          {
            "name": "Flagged Late % (Order)",
            "expression": "CALCULATE ( [Late %], fact_po[flag_order] = 1 )",
            "lineageTag": "c1d209fc-44f9-5260-be09-7065d9654fa5",
            "displayFolder": "3 Late delivery",
            "formatString": "0.0%"
          },
          {
            "name": "Flagged Late % (Pre)",
            "expression": "CALCULATE ( [Late %], fact_po[flag_pre] = 1 )",
            "lineageTag": "2a1e4a78-89ff-5835-8553-d96e0f1559fd",
            "displayFolder": "3 Late delivery",
            "formatString": "0.0%"
          },
          {
            "name": "Late Caught (Pre)",
            "expression": "DIVIDE ( CALCULATE ( SUM ( fact_po[late] ), fact_po[flag_pre] = 1 ), CALCULATE ( SUM ( fact_po[late] ), fact_po[split] = \"Test\" ) )",
            "lineageTag": "028952de-f08b-5750-bb17-fc48edd33a61",
            "displayFolder": "3 Late delivery",
            "formatString": "0.0%"
          },
          {
            "name": "Flagged Callout",
            "expression": "\"Top 25% reviewed 3 days out · catches \" & FORMAT ( [Late Caught (Pre)], \"0%\" ) & \" of late POs\"",
            "lineageTag": "393b27f1-47d6-585a-9748-a762c6a8f16c",
            "displayFolder": "3 Late delivery"
          },
          {
            "name": "Test Late Callout",
            "expression": "FORMAT ( CALCULATE ( [POs], fact_po[split] = \"Test\" ), \"#,0\" ) & \" test POs, Jul–Dec 2025\"",
            "lineageTag": "52a21942-68d2-5363-9151-5f4f18b1d681",
            "displayFolder": "3 Late delivery"
          },
          {
            "name": "Driver Importance",
            "expression": "SUM ( driver_importance[pr_auc_lost_when_removed] )",
            "lineageTag": "e755dfab-a1ac-5a7e-b59a-0ad51ff8c412",
            "displayFolder": "3 Late delivery",
            "formatString": "0.000"
          },
          {
            "name": "Questions",
            "expression": "COUNTROWS ( contract_qa )",
            "lineageTag": "03c65ebc-baf2-5b5f-9b70-14c9aabc4c1b",
            "displayFolder": "4 Contract assistant",
            "formatString": "#,0"
          },
          {
            "name": "Correct",
            "expression": "SUM ( contract_qa[is_correct] )",
            "lineageTag": "c78c0424-21b2-5cd8-8352-f132b38a4791",
            "displayFolder": "4 Contract assistant",
            "formatString": "#,0"
          },
          {
            "name": "Accuracy",
            "expression": "DIVIDE ( [Correct], [Questions] )",
            "lineageTag": "66b5a201-31fd-5df6-bcb0-d2e8ab9be0a0",
            "displayFolder": "4 Contract assistant",
            "formatString": "0.0%"
          },
          {
            "name": "Contract Score",
            "expression": "FORMAT ( [Correct], \"0\" ) & \" / \" & FORMAT ( [Questions], \"0\" )",
            "lineageTag": "a69d4e80-7900-54cc-b7f7-d511c6b194ad",
            "displayFolder": "4 Contract assistant"
          },
          {
            "name": "Wrong Answers",
            "expression": "CALCULATE ( [Questions], contract_qa[result] = \"Wrong answer\" ) + 0",
            "lineageTag": "18811be9-e9bd-508e-9c13-a76b2b8cccbc",
            "displayFolder": "4 Contract assistant",
            "formatString": "0"
          },
          {
            "name": "Refusals Correct",
            "expression": "FORMAT ( CALCULATE ( [Correct], contract_qa[answerable] = 0 ), \"0\" ) & \" / \" & FORMAT ( CALCULATE ( [Questions], contract_qa[answerable] = 0 ), \"0\" )",
            "lineageTag": "1612120d-3945-587f-a6a5-0566b4aa4f1b",
            "displayFolder": "4 Contract assistant"
          },
          {
            "name": "Contract Callout",
            "expression": "FORMAT ( [Accuracy], \"0.0%\" ) & \" · question set locked before any code\"",
            "lineageTag": "08e27ac4-4805-547b-a3c4-dcb1d508385b",
            "displayFolder": "4 Contract assistant"
          }
        ]
      },
