              "type": "m",
              "expression": [
                "let",
                "    Folder = if Text.EndsWith(DataFolder, \"\\\") then DataFolder else DataFolder & \"\\\",",
                "    Source = Csv.Document(File.Contents(Folder & \"fact_po.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
