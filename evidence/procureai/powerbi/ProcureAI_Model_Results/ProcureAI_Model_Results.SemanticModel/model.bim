                "    Typed = Table.TransformColumnTypes(Nulls, {{\"po_id\", type text}, {\"order_date\", type date}, {\"promised_date\", type date}, {\"receipt_date\", type date}, {\"supplier_id\", type text}, {\"warehouse_id\", type text}, {\"po_value\", Currency.Type}, {\"late\", Int64.Type}, {\"lead_days\", Int64.Type}, {\"quoted_lead_time_days\", Int64.Type}, {\"promise_slack_days\", Int64.Type}, {\"road_distance_km\", type number}, {\"route_type\", type text}, {\"utilisation\", type number}, {\"festival_window\", Int64.Type}, {\"dest_flood_risk\", type number}, {\"dispatched_by_rescore\", Int64.Type}, {\"dispatch_slip_seen\", Int64.Type}, {\"advisory\", Int64.Type}, {\"supplier_past_late_rate\", type number}, {\"split\", type text}, {\"p_order\", type number}, {\"p_pre\", type number}, {\"flag_order\", Int64.Type}, {\"flag_pre\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
